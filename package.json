{
  "author": "Dario Sechi",
  "devDependencies": {
    "@aracna/core": "^1.3.2",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "esbuild": "^0.25.9",
    "glob": "^11.0.3",
    "prettier": "^3.6.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=10"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
    },
    "./assets/*": {
      "types": "./assets/*.d.ts",
      "import": "./assets/*.js",
      "require": "./assets/*.cjs"
    }
  },
  "license": "MIT",
  "main": "index.cjs",
  "module": "index.js",
  "name": "@aracna/icons-feather",
  "packageManager": "pnpm@10.15.0+sha512.486ebc259d3e999a4e8691ce03b5cac4a71cbeca39372a9b762cb500cfdf0873e2cb16abe3d951b1ee2cf012503f027b98b6584e4df22524e0c7450d9ec7aa7b",
  "publishConfig": {
    "directory": "dist"
  },
  "repository": "https://github.com/queelag/icons-feather",
  "scripts": {
    "build": "node scripts/generate-exports.mjs && node esbuild.mjs && pnpm tsc",
    "prepublish": "pnpm test && pnpm build && node scripts/pre-publish.mjs",
    "test": "vitest run"
  },
  "sideEffects": false,
  "type": "module",
  "types": "index.d.ts",
  "version": "1.0.13"
}
