{
  "author": "Dario Sechi",
  "devDependencies": {
    "@aracna/core": "^1.3.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.3",
    "@vitest/ui": "^3.2.3",
    "esbuild": "^0.25.5",
    "glob": "^11.0.2",
    "prettier": "^3.5.3",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=10"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
    },
    "./assets/*": {
      "types": "./assets/*.d.ts",
      "import": "./assets/*.js",
      "require": "./assets/*.cjs"
    }
  },
  "license": "MIT",
  "main": "index.cjs",
  "module": "index.js",
  "name": "@aracna/icons-feather",
  "packageManager": "pnpm@10.12.1",
  "publishConfig": {
    "directory": "dist"
  },
  "repository": "https://github.com/queelag/icons-feather",
  "scripts": {
    "build": "node scripts/generate-exports.mjs && node esbuild.mjs && pnpm tsc",
    "prepublish": "pnpm test && pnpm build && node scripts/pre-publish.mjs",
    "test": "vitest run"
  },
  "sideEffects": false,
  "type": "module",
  "types": "index.d.ts",
  "version": "1.0.12"
}
